<!DOCTYPE html>
<html>
<head>
    <title>Student Grade Calculator</title>

    <style>
        body {
            font-family: Arial;
            text-align: center;
            margin-top: 50px;
        }

        input {
            padding: 8px;
            margin: 5px;
        }

        button {
            padding: 10px 20px;
            cursor: pointer;
        }

        #result {
            margin-top: 20px;
            font-size: 20px;
        }
    </style>

</head>

<body>

    <h2>Student Marks and Grade Calculator</h2>

    <label>Enter Number of Subjects:</label>
    <input type="number" id="subjects">

    <br>

    <button onclick="calculate()">Calculate Result</button>


    <div id="result"></div>


<script>

function calculate(){

    let n = document.getElementById("subjects").value;

    let total = 0;


    // loop to enter marks
    for(let i = 1; i <= n; i++){

        let marks = Number(prompt("Enter marks of subject " + i));

        total = total + marks;

    }


    let average = total / n;


    let grade;
    let result;


    // grade calculation

    if(average >= 90){
        grade = "A+";
    }
    else if(average >= 80){
        grade = "A";
    }
    else if(average >= 70){
        grade = "B";
    }
    else if(average >= 60){
        grade = "C";
    }
    else{
        grade = "D";
    }
+++++++++++

    // pass fail

    if(average >= 40){
        result = "Pass";
    }
    else{
        result = "Fail";
    }



    document.getElementById("result").innerHTML =
    "Total Marks: " + total +
    "<br>Average: " + average.toFixed(2) +
    "<br>Grade: " + grade +
    "<br>Result: " + result;3


}

</script>


</body>
</html>
